{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "ingredient.schema#/$defs/ingredient"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "recipe.schema#/$defs/recipe"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": ["ingredients", "recipes"]
}
